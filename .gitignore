/target
Cargo.lock
.DS_Store
geopackage-core/fuzz/target
geopackage-core/fuzz/corpus
geopackage-core/fuzz/artifacts
geopackage-core/fuzz/coverage
# Python bytecode that an import of generate_fixtures.py creates in scripts/.
__pycache__/

# Externally fetched corpus (scripts/fetch_corpus.sh); never committed.
/corpus

# Externally fetched benchmark datasets (scripts/bench_datasets.sh); several
# gigabytes, and never committed.
/benchdata

# Default output path of the bulk_load example when run without an argument.
/bulk_load.gpkg

# The file emit_representative_file writes for the external validators. It
# defaults to target/, so this only catches a GPKG_REPRESENTATIVE_OUT pointed
# at the source tree; one of these was committed by accident once.
representative.gpkg

# Hegel property-test server cache + failure database.
.hegel/

# The QGIS plugin's bundled native modules, written by
# scripts/package_qgis_plugin.py into the zip, or by hand for development.
qgis-plugin/gpkg_toolkit/ext-libs/
# maturin develop's in-place build of the native module.
geopackage-py/python/geopackage_rs/*.so
geopackage-py/python/geopackage_rs/*.pyd

# The native QGIS provider builds outside the workspace, so into its own target.
geopackage-qgis/target
